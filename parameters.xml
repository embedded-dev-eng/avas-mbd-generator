<?xml version="1.0" encoding="UTF-8"?>
<!-- Parametres AVAS bases sur le reglement UN R138 (Acoustic Vehicle Alerting System) -->
<ModelParameters system="AVAS_ElectricVehicle">
  <Function id="F01" name="SpeedSensorInterface">
    <Parameter name="SamplingRate_Hz" value="100" type="double"/>
    <Parameter name="SpeedRange_kmh_min" value="0" type="double"/>
    <Parameter name="SpeedRange_kmh_max" value="130" type="double"/>
  </Function>

  <Function id="F02" name="SoundGenerator">
    <Parameter name="ActivationSpeed_kmh_min" value="0" type="double"/>
    <Parameter name="ActivationSpeed_kmh_max" value="20" type="double"/>
    <Parameter name="FrequencyBand_Hz_min" value="160" type="double"/>
    <Parameter name="FrequencyBand_Hz_max" value="5000" type="double"/>
    <Parameter name="ReverseGearTone_Hz" value="440" type="double"/>
  </Function>

  <Function id="F03" name="VolumeControl">
    <Parameter name="SoundLevel_dB_min" value="56" type="double"/>
    <Parameter name="SoundLevel_dB_max" value="75" type="double"/>
    <Parameter name="RampUpSpeed_kmh_start" value="0" type="double"/>
    <Parameter name="RampUpSpeed_kmh_end" value="20" type="double"/>
  </Function>

  <Function id="F04" name="SpeakerOutputDriver">
    <Parameter name="OutputImpedance_ohm" value="4" type="double"/>
    <Parameter name="MaxPower_W" value="30" type="double"/>
  </Function>
</ModelParameters>
